{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "openapi:export": "nest build && node dist/openapi-export.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "admin:grant": "nest build && node dist/cli/admin-role.js grant",
    "admin:revoke": "nest build && node dist/cli/admin-role.js revoke"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@aws-sdk/s3-request-presigner": "3.1157.0",
    "@clerk/backend": "3.26.3",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.4",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "23.0.1",
    "svix": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "@testcontainers/postgresql": "12.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
