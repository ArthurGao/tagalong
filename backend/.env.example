NODE_ENV=development
PORT=3810
DATABASE_URL=postgresql://tagalong:tagalong@localhost:5442/tagalong
APP_URL=http://localhost:3800
CLERK_SECRET_KEY=
CLERK_JWT_KEY=                # PEM public key from Clerk dashboard (networkless verification)
CLERK_AUTHORIZED_PARTIES=http://localhost:3800,http://admin.localhost:3800
CLERK_WEBHOOK_SIGNING_SECRET=
ADMIN_EMAIL_ALLOWLIST=           # comma-separated
STRIPE_SECRET_KEY=
TURNSTILE_SECRET_KEY=          # empty outside production = Cloudflare's always-pass test secret
ORDER_RATE_LIMIT_PER_MINUTE=10
TRUST_PROXY=loopback          # Express trust proxy: hops allowed to set X-Forwarded-For (1 on Render)
# Shared with the web app (frontend EDGE_SECRET): its proxy passes the buyer IP with it; empty locally
EDGE_SECRET=
STRIPE_WEBHOOK_SECRET_CONNECT=
STRIPE_WEBHOOK_SECRET_PLATFORM=
PLATFORM_FEE_BPS=300
PLATFORM_FEE_FIXED_CENTS=0
RESERVATION_MINUTES=30
EMAIL_PROVIDER=mailpit        # mailpit | resend
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=localhost           # Mailpit (docker compose)
SMTP_PORT=1026
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# development | staging | production (staging and production both run NODE_ENV=production)
APP_ENV=development
# Sentry error reporting: off when empty; required in production
SENTRY_DSN=
# Set by Render to the deployed commit (shown by /api/v1/health); leave empty locally
RENDER_GIT_COMMIT=
