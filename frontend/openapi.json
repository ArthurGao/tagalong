  "info": {
    "title": "TagAlong API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Role": {
        "type": "string",
        "enum": [
          "MERCHANT",
          "ADMIN"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "hasMerchantProfile": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "hasMerchantProfile"
        ]
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateMerchantDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "xiaolin-farm"
          },
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "logoUrl": {
            "type": "string"
          },
          "contactEmail": {
            "type": "string"
          },
          "contactPhone": {
            "type": "string",
            "example": "+64 21 123 4567"
          },
          "gstNumber": {
            "type": "string",
            "example": "123-456-789"
          }
        },
        "required": [
          "slug",
          "displayName",
          "contactEmail",
          "contactPhone"
        ]
      },
      "MerchantStatus": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "SUSPENDED"
        ]
      },
      "MerchantDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "logoUrl": {
            "type": "string",
            "nullable": true
          },
          "contactEmail": {
            "type": "string"
          },
          "contactPhone": {
            "type": "string"
          },
          "gstNumber": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MerchantStatus"
              }
            ]
          },
          "stripeConnected": {
            "type": "boolean",
            "description": "A Stripe connected account exists (onboarding may still be incomplete)"
          },
          "chargesEnabled": {
            "type": "boolean"
          },
          "payoutsEnabled": {
            "type": "boolean"
          },
          "detailsSubmitted": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "displayName",
          "description",
          "logoUrl",
          "contactEmail",
          "contactPhone",
          "gstNumber",
          "status",
          "stripeConnected",
          "chargesEnabled",
          "payoutsEnabled",
          "detailsSubmitted",
          "createdAt"
        ]
      },
      "ErrorBodyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "TURNSTILE_FAILED",
              "BAD_REQUEST",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "LISTING_NOT_PUBLISHED",
              "LISTING_CLOSED",
              "MERCHANT_SUSPENDED",
              "MERCHANT_PROFILE_EXISTS",
              "SLUG_TAKEN",
              "MERCHANT_NOT_CHARGEABLE",
              "SOLD_OUT",
              "ALREADY_REGISTERED",
              "QTY_EXCEEDS_LIMIT",
              "INVALID_STATE_TRANSITION",
              "FIELD_LOCKED_AFTER_PUBLISH",
              "CAPACITY_BELOW_SOLD",
              "OPTION_HAS_ORDERS",
              "SELF_CANCEL_WINDOW_PASSED",
              "REFUND_EXCEEDS_TOTAL",
              "PRICE_OUT_OF_RANGE",
              "RATE_LIMITED",
              "STRIPE_ERROR",
              "INTERNAL"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "UpdateMerchantDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "logoUrl": {
            "type": "string"
          },
          "contactEmail": {
            "type": "string"
          },
          "contactPhone": {
            "type": "string",
            "example": "+64 21 123 4567"
          },
          "gstNumber": {
            "type": "string",
            "example": "123-456-789"
          }
        }
      },
      "StripeLinkDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      }
    }
  }
}
