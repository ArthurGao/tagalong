                "schema": {
                  "$ref": "#/components/schemas/MerchantDto"
                }
              }
            }
          },
          "409": {
            "description": "MERCHANT_PROFILE_EXISTS or SLUG_TAKEN",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                }
              }
            }
          },
          "default": {
            "description": "Error (code from DESIGN §17)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "__session": []
          }
        ],
